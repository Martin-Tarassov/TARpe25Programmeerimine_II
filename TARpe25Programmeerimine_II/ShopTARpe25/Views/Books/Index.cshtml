@model IEnumerable<ShopTARpe25.Models.Books.BookIndexViewModel>

@{
    int rowNumber = 1;
}

<div>
    <a asp-action="Create" asp-controller="Books" class="btn btn-primary">Create</a>
    <a asp-action="Index" asp-controller="Books" class="btn btn-secondary">All</a>
    <a asp-action="Borrowed" asp-controller="Books" class="btn btn-secondary">Borrowed</a>
</div>

<div class="h1">
    Books
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-warning">@TempData["Message"]</div>
}

<form asp-action="ByYear" method="get">
    <div class="input-group mb-2">
        <input name="year" type="number" class="form-control" placeholder="Year" />
        <button type="submit" class="btn btn-outline-primary">Search by year</button>
    </div>
</form>

<form asp-action="ByTitle" method="get">
    <div class="input-group mb-3">
        <input name="title" class="form-control" placeholder="Title" />
        <button type="submit" class="btn btn-outline-primary">Search by title</button>
    </div>
</form>

<table class="table table-hover">
    <thead>
        <tr>
            <th scope="col">Nr</th>
            <th scope="col">Title</th>
            <th scope="col">Author</th>
            <th scope="col">Year</th>
            <th scope="col">Available</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@rowNumber</td>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.PublishedYear</td>
                <td>@(book.IsAvailable ? "Yes" : "No")</td>
                <td>
                    <a asp-action="Details" asp-controller="Books" asp-route-id="@book.Id" class="btn btn-info">Details</a>
                    <a asp-action="Update" asp-controller="Books" asp-route-id="@book.Id" class="btn btn-success">Update</a>
                    <a asp-action="Delete" asp-controller="Books" asp-route-id="@book.Id" class="btn btn-danger">Delete</a>
                    <form asp-action="Return" asp-controller="Books" asp-route-id="@book.Id" method="post" class="d-inline">
                        <input type="submit" value="Return" class="btn btn-warning" />
                    </form>
                </td>
            </tr>
            rowNumber++;
        }
    </tbody>
</table>