@model ShopTARpe25.Models.Books.ReaderCreateViewModel

<h1>Reader Create</h1>

<form method="post">
    <div>
        <label asp-for="FullName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="FullName" class="form-control" />
        </div>
    </div>

    <div>
        <label asp-for="Email" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Email" class="form-control" />
        </div>
    </div>

    <hr />

    <input asp-action="CreateReader" asp-controller="Books" type="submit" class="btn btn-primary" value="Create" />
    <a asp-action="Readers" asp-controller="Books" class="btn btn-secondary">Back to List</a>
</form>