@model IEnumerable<ShopTARpe25.Models.RealEstates.RealEstateIndexViewModel>

@{
    int rowNumber = 1;
}

<div>
    <a asp-action="Create" asp-controller="RealEstates" class="btn btn-primary">Create</a>
</div>

<div class="h1">
    Real Estates
</div>

<table class="table table-hover">
    <thead>
        <tr>
            <th scope="col">Nr</th>
            <th scope="col">Address</th>
            <th scope="col">Area</th>
            <th scope="col">Room Number</th>
            <th scope="col">Building Type</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var estate in Model)
        {
            <tr>
                <td>@rowNumber</td>
                <td>@estate.Address</td>
                <td>@estate.Area</td>
                <td>@estate.RoomNumber</td>
                <td>@estate.BuildingType</td>
                <td>
                    <a asp-action="Details" asp-controller="RealEstates" asp-route-id="@estate.Id" class="btn btn-info">Details</a>
                    <a asp-action="Update" asp-controller="RealEstates" asp-route-id="@estate.Id" class="btn btn-success">Update</a>
                    <a asp-action="Delete" asp-controller="RealEstates" asp-route-id="@estate.Id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
            rowNumber++;
        }
    </tbody>
</table>