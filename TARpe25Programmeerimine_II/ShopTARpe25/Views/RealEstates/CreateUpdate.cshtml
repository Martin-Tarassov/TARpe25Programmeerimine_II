@model ShopTARpe25.Models.RealEstates.RealEstateCreateUpdateViewModel

<div>
    @if (Model.Id.HasValue)
    {
        <h1>Real Estate Update</h1>
    }
    else
    {
        <h1>Real Estate Create</h1>
    }

    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        
        <input asp-for="Id" type="hidden" />
        <input asp-for="CreatedAt" type="hidden" />
        <input asp-for="ModifiedAt" type="hidden" />

        <div class="form-group">
            <label asp-for="Address" class="control-label"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Area" class="control-label"></label>
            <input asp-for="Area" class="form-control" />
            <span asp-validation-for="Area" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="RoomNumber" class="control-label"></label>
            <input asp-for="RoomNumber" class="form-control" />
            <span asp-validation-for="RoomNumber" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="BuildingType" class="control-label"></label>
            <input asp-for="BuildingType" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="Files" class="control-label"></label>
            <input asp-for="Files" class="form-control" type="file" multiple />
        </div>

        <div>
            @foreach (var images in Model.Image)
            {
                <partial name="_Images" model="images" />
                <input asp-action="RemoveImage" asp-controller="RealEstates" asp-route-imageId="@images.ImageId" type="submit" class="btn btn-danger" value="Remove Image" />
            }
        </div>

        <div>
            @if (Model.Id.HasValue)
            {
                <input asp-action="Update" asp-controller="RealEstates" asp-route-id="@Model.Id" type="submit" class="btn btn-primary" value="Update" />
            }
            else
            {
                <input asp-action="Create" asp-controller="RealEstates" type="submit" class="btn btn-primary" value="Create" />
            }
            <a asp-action="Index" asp-controller="RealEstates" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>
