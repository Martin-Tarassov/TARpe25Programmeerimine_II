@model ShopTARpe25.Models.RealEstates.RealEstateCreateUpdateViewModel

<h1>@(Model.Id == null ? "Create" : "Update")</h1>

<div>
    <h4>Real Estate</h4>
    <hr />

    <form asp-action="@(Model.Id == null ? "Create" : "Update")" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
        <input type="hidden" asp-for="ModifiedAt" />

        <div class="form-group row">
            <label asp-for="Address" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Address" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Area" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Area" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="RoomNumber" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="RoomNumber" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="BuildingType" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="BuildingType" class="form-control" />
            </div>
        </div>

        <hr />
        <input type="submit" value="@(Model.Id == null ? "Create" : "Update")" class="btn btn-primary" />
        <a asp-action="Index" asp-controller="RealEstates" class="btn btn-success">Back</a>
    </form>
</div>