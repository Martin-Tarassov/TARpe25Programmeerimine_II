@model IEnumerable<ShopTARpe25.Models.Kindergarten.KindergartenIndexViewModel>

@{
    int rowNumber = 1;
}

<div>
    <a asp-action="Create" asp-controller="Kindergarten" class="btn btn-primary">Create</a>
</div>

<div class="h1">
    Kindergarten
</div>

<table class="table table-hover">
    <thead>
        <tr>
            <th scope="col">Nr</th>
            <th scope="col">Group</th>
            <th scope="col">Children</th>
            <th scope="col">Kindergarten</th>
            <th scope="col">Teacher</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@rowNumber</td>
                <td>@item.GroupName</td>
                <td>@item.ChildrenCount</td>
                <td>@item.KindergartenName</td>
                <td>@item.TeacherName</td>
                <td>
                    <a asp-action="Details" asp-controller="Kindergarten" asp-route-id="@item.Id" class="btn btn-info">Details</a>
                    <a asp-action="Update" asp-controller="Kindergarten" asp-route-id="@item.Id" class="btn btn-success">Update</a>
                    <a asp-action="Delete" asp-controller="Kindergarten" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
            rowNumber++;
        }
    </tbody>
</table>