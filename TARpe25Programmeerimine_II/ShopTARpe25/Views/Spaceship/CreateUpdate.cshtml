@model ShopTARpe25.Models.Kindergarten.KindergartenCreateUpdateViewModel

@if (Model.Id.HasValue)
{
    <h1>Kindergarten Update</h1>
}
else
{
    <h1>Kindergarten Create</h1>
}

<form method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="UpdatedAt" type="hidden" />

    <div>
        <label asp-for="GroupName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="GroupName" class="form-control" />
        </div>
    </div>

    <div>
        <label asp-for="ChildrenCount" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="ChildrenCount" class="form-control" />
        </div>
    </div>

    <div>
        <label asp-for="KindergartenName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="KindergartenName" class="form-control" />
        </div>
    </div>

    <div>
        <label asp-for="TeacherName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="TeacherName" class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Files" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-5">
            <input asp-for="Files" class="form-control" type="file" multiple />
        </div>
    </div>

    <div>
        @foreach (var images in Model.Images)
        {
            <partial name="_Images" model="images" />
            <input asp-action="RemoveImage" asp-controller="Kindergarten"
                   asp-route-imageId="@images.ImageId" asp-route-id="@Model.Id"
                   type="submit" class="btn btn-danger" value="Remove Image" />
        }
    </div>

    <hr />

    @if (Model.Id.HasValue)
    {
        <input asp-action="Update" asp-controller="Kindergarten" type="submit" class="btn btn-primary" value="Update" />
    }
    else
    {
        <input asp-action="Create" asp-controller="Kindergarten" type="submit" class="btn btn-primary" value="Create" />
    }

    <a asp-action="Index" asp-controller="Kindergarten" class="btn btn-secondary">Back to List</a>

</form>